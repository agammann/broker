# No secret values belong in environment files.
# Defaults are loopback-only. Production starts with no fixture adapter enabled.
BROKER_OWNER_ORIGIN=http://127.0.0.1:4310
BROKER_GATEWAY_URL=http://127.0.0.1:4311
BROKER_DB=data/broker.db
BROKER_SETUP_TOKEN_FILE=.secrets/setup
BROKER_INTERNAL_KEY_FILE=.secrets/internal
# Set only for the bundled synthetic portal, never for external accounts.
# BROKER_ENABLE_FIXTURE=1
# BROKER_FIXTURE_ORIGIN=http://127.0.0.1:4313
# BROKER_FIXTURE_USERS_FILE=.secrets/fixture-users.json
